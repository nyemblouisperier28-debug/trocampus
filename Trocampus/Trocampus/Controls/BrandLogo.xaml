<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Trocampus.Controls.BrandLogo">
    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
        <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0"
                BackgroundColor="{StaticResource Primary}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Image Source="arrow_left_right.png" WidthRequest="22" HeightRequest="22"
                   HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
        <Label Text="trocampus" FontFamily="InterRegular" FontSize="22"
               TextColor="{StaticResource TcText}" VerticalOptions="Center" />
    </HorizontalStackLayout>
</ContentView>
<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Trocampus.Controls.NavTab"
             WidthRequest="76">
    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
        <Image x:Name="Icon" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center">
            <Image.Behaviors>
                <toolkit:IconTintColorBehavior x:Name="Tint" />
            </Image.Behaviors>
        </Image>
        <Label x:Name="Caption" FontSize="11" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentView>
<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Trocampus.Controls"
             x:Class="Trocampus.Controls.BottomTabBar">
    <Grid RowDefinitions="1,Auto" BackgroundColor="{StaticResource TcBackground}">
        <BoxView Color="{StaticResource TcBorder}" HeightRequest="1" />
        <Grid Grid.Row="1" Padding="20,14,20,14"
              ColumnDefinitions="76,*,76,*,76,*,76">
            <local:NavTab x:Name="HomeTab" Grid.Column="0" Text="Accueil"
                          IconSource="tab_house.png" Route="home" />
            <local:NavTab x:Name="SearchTab" Grid.Column="2" Text="Recherche"
                          IconSource="tab_search.png" Route="search" />
            <local:NavTab x:Name="ExchangesTab" Grid.Column="4" Text="Échanges"
                          IconSource="tab_exchange.png" Route="exchanges" />
            <local:NavTab x:Name="ProfileTab" Grid.Column="6" Text="Profil"
                          IconSource="tab_user.png" Route="profile" />
        </Grid>
    </Grid>
</ContentView>
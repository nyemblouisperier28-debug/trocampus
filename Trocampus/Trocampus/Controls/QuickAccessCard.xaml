<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Trocampus.Controls.QuickAccessCard">
    <Border x:Name="Card" Style="{StaticResource TcCardBorder}">
        <VerticalStackLayout Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
                <Image Source="{Binding IconSource}" WidthRequest="20" HeightRequest="20"
                       HorizontalOptions="Start" />
                <Image Grid.Column="1" Source="chevron_right_16.png"
                       WidthRequest="16" HeightRequest="16" />
            </Grid>
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Title}" FontFamily="InterMedium" FontSize="14"
                       TextColor="{StaticResource TcText}" />
                <Label Text="{Binding Subtitle}" FontFamily="InterRegular" FontSize="12"
                       TextColor="{StaticResource TcMuted}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
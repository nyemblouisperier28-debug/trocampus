<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Trocampus.Controls.SelectField">
    <VerticalStackLayout x:Name="Root" Spacing="8">
        <Label Text="{Binding Title}" Style="{StaticResource TcBody14}" />
        <Border Style="{StaticResource TcFieldBox}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTapped" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{Binding Value}" Style="{StaticResource TcBody14}"
                       VerticalOptions="Center" />
                <Image Grid.Column="1" Source="chevron_down.png" WidthRequest="16"
                       HeightRequest="16" VerticalOptions="Center" />
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentView>
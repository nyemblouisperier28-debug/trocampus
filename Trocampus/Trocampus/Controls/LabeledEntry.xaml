<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Trocampus.Controls.LabeledEntry">
    <VerticalStackLayout x:Name="Root" Spacing="8">
        <Label Text="{Binding Title}" Style="{StaticResource TcFieldLabel}" />
        <Border Style="{StaticResource TcInputBorder}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Entry Text="{Binding Text, Mode=TwoWay}"
                       Placeholder="{Binding Placeholder}"
                       Keyboard="{Binding Keyboard}"
                       IsPassword="{Binding IsTextHidden}"
                       Style="{StaticResource TcInput}"
                       VerticalOptions="Center" />
                <Image Grid.Column="1" Source="eye.png" WidthRequest="20" HeightRequest="20"
                       VerticalOptions="Center" IsVisible="{Binding IsPassword}">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleEye" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </Border>
        <Label Text="{Binding Hint}" Style="{StaticResource TcCaption}" LineHeight="1.4"
               IsVisible="{Binding HasHint}" />
    </VerticalStackLayout>
</ContentView>
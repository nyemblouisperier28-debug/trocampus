<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Trocampus.Controls"
             x:Class="Trocampus.Pages.ExchangesPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource TcBackground}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout>
                <controls:AppHeader />
                <VerticalStackLayout Padding="28,16,28,28" Spacing="20">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mes échanges" Style="{StaticResource TcTitle}" />
                        <Label Text="Rendez-vous à venir et échanges terminés." Style="{StaticResource TcSubtitle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="12">
                        <Label x:Name="AppointmentsTitle" Text="Rendez-vous à venir" Style="{StaticResource TcSectionTitle}" />
                        <VerticalStackLayout x:Name="AppointmentsList" Spacing="12" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Récemment terminés" Style="{StaticResource TcSectionTitle}" />
                        <Label Text="Aucun échange terminé pour le moment."
                               Style="{StaticResource TcMeta12}" />
                    </VerticalStackLayout>
                    <Button Text="Offres reçues" Style="{StaticResource TcSecondaryButton}"
                            Clicked="OnOffersClicked" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <controls:BottomTabBar Grid.Row="1" ActiveTab="exchanges" />
    </Grid>
</ContentPage>

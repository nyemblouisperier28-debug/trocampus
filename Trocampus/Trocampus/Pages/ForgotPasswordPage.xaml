<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Trocampus.Controls"
             x:Class="Trocampus.Pages.ForgotPasswordPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource TcBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="28,30,28,52">
            <controls:BrandLogo HorizontalOptions="Start" Margin="0,0,0,54" />
            <VerticalStackLayout Spacing="28">
                <!-- Introduction -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Mot de passe oublié ?" Style="{StaticResource TcTitle}" />
                    <Label Style="{StaticResource TcSubtitle}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Indiquez votre adresse e-mail. " />
                                <Span Text="Nous vous enverrons un lien pour créer un nouveau mot de passe." />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
                <!-- Formulaire de récupération -->
                <VerticalStackLayout Spacing="20">
                    <controls:LabeledEntry x:Name="EmailField"
                                           Title="Adresse e-mail"
                                           Placeholder="vous@exemple.fr"
                                           Keyboard="Email" />
                    <Button Text="Envoyer le lien" Style="{StaticResource TcPrimaryButton}"
                            Clicked="OnSendLinkClicked" />
                </VerticalStackLayout>
                <!-- Retour à la connexion -->
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Image Source="arrow_left.png" WidthRequest="17" HeightRequest="17"
                           VerticalOptions="Center" />
                    <Label Text="Retour à la connexion" FontFamily="InterSemiBold" FontSize="14"
                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Trocampus.Controls"
             x:Class="Trocampus.Pages.OffersPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource TcBackground}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout>
                <controls:AppHeader />
                <VerticalStackLayout Padding="28,16,28,28" Spacing="20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Offres reçues" Style="{StaticResource TcTitle}" />
                        <Label Text="Les propositions faites sur vos annonces." Style="{StaticResource TcSubtitle}" />
                    </VerticalStackLayout>
                    <controls:FilterChips Items="À traiter,Acceptées,Refusées" SelectedIndex="0" />
                    <VerticalStackLayout Spacing="12">
                        <Label x:Name="OffersCountLabel" Text="Offres" Style="{StaticResource TcSectionTitle}" />
                        <VerticalStackLayout x:Name="OffersResults" Spacing="12" />
                    </VerticalStackLayout>
                    <Button Text="Voir mes annonces" Style="{StaticResource TcSecondaryButton}" Clicked="OnListingsClicked" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <controls:BottomTabBar Grid.Row="1" ActiveTab="exchanges" />
    </Grid>
</ContentPage>

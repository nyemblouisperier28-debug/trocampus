<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Trocampus.Controls"
             x:Class="Trocampus.Pages.OffersPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource TcBackground}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout>
                <controls:AppHeader />
                <VerticalStackLayout Padding="28,16,28,28" Spacing="20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Offres reçues" Style="{StaticResource TcTitle}" />
                        <Label Text="Les propositions faites sur vos annonces." Style="{StaticResource TcSubtitle}" />
                    </VerticalStackLayout>
                    <controls:FilterChips Items="À traiter,Acceptées,Refusées" SelectedIndex="0" />
                    <VerticalStackLayout Spacing="12">
                        <Label Text="À traiter · 2" Style="{StaticResource TcSectionTitle}" />
                        <Border Style="{StaticResource TcPanel}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOfferTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Lampe de bureau ↔ bouilloire" Style="{StaticResource TcBody14}" FontFamily="InterSemiBold" />
                                <Label Text="Sami Benali · reçue aujourd’hui · en attente" Style="{StaticResource TcMeta12}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource TcPanel}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOfferTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Manuels de statistiques ↔ roman" Style="{StaticResource TcBody14}" FontFamily="InterSemiBold" />
                                <Label Text="Nina Moreau · reçue hier · en attente" Style="{StaticResource TcMeta12}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                    <Button Text="Voir mes annonces" Style="{StaticResource TcSecondaryButton}" Clicked="OnListingsClicked" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <controls:BottomTabBar Grid.Row="1" ActiveTab="exchanges" />
    </Grid>
</ContentPage>

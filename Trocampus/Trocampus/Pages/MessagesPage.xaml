<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Trocampus.Controls"
             x:Class="Trocampus.Pages.MessagesPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource TcBackground}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout>
                <controls:AppHeader />
                <VerticalStackLayout Padding="28,16,28,28" Spacing="20"
                                     MinimumHeightRequest="644">
                    <!-- Introduction -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Messagerie" Style="{StaticResource TcTitle}" />
                        <Label Text="Vos conversations avec les étudiants."
                               Style="{StaticResource TcSubtitle}" LineHeight="1.45" />
                    </VerticalStackLayout>
                    <!-- Recherche -->
                    <Border Style="{StaticResource TcFieldBox}">
                        <Entry Placeholder="Rechercher une conversation"
                               Style="{StaticResource TcSearchInput}" />
                    </Border>
                    <!-- Conversations -->
                    <VerticalStackLayout Spacing="12">
                        <Label x:Name="ConversationsTitle" Text="Conversations" Style="{StaticResource TcSectionTitle}" />
                        <VerticalStackLayout x:Name="ConversationsList" Spacing="10" />
                        <VerticalStackLayout x:Name="MessagesList" Spacing="8" IsVisible="False" />
                        <Grid x:Name="MessageComposer" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="False">
                            <Entry x:Name="MessageEntry" Placeholder="Écrire un message" />
                            <Button Grid.Column="1" Text="Envoyer" Style="{StaticResource TcPrimaryButton}"
                                    Clicked="OnSendMessageClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <controls:BottomTabBar Grid.Row="1" ActiveTab="home" />
    </Grid>
</ContentPage>
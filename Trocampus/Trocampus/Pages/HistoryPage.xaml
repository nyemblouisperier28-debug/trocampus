<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Trocampus.Controls"
             x:Class="Trocampus.Pages.HistoryPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource TcBackground}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout>
                <controls:AppHeader />
                <VerticalStackLayout Padding="28,16,28,28" Spacing="20"
                                     MinimumHeightRequest="644">
                    <!-- Retour -->
                    <Label Text="‹  Mes échanges" Style="{StaticResource TcLinkLarge}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <!-- Introduction -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Historique des échanges" Style="{StaticResource TcTitle}" />
                        <Label Text="Les rencontres terminées et leurs résultats."
                               Style="{StaticResource TcSubtitle}" LineHeight="1.45" />
                    </VerticalStackLayout>
                    <!-- Récapitulatif -->
                    <Border BackgroundColor="{StaticResource TcSurfaceTint}"
                            StrokeThickness="0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="5 échanges terminés" FontFamily="InterRegular"
                                   FontSize="22" LineHeight="1.45"
                                   TextColor="{StaticResource TcText}" />
                            <Label Text="4 réussis · 1 échoué" FontFamily="InterRegular"
                                   FontSize="13" LineHeight="1.45"
                                   TextColor="{StaticResource TcMuted}" />
                        </VerticalStackLayout>
                    </Border>
                    <!-- Filtres et période -->
                    <controls:FilterChips Items="Tous,Réussis,Échoués" SelectedIndex="0" />
                    <controls:SelectField Title="Période" Value="Septembre 2026"
                                          Options="Septembre 2026,Août 2026,Juillet 2026" />
                    <!-- Échanges terminés -->
                    <VerticalStackLayout Spacing="12">
                        <controls:ExchangeResultCard Date="24 septembre 2026"
                            Title="Petit bureau ↔ Étagère en bois"
                            Partner="Avec Camille Robert" />
                        <controls:ExchangeResultCard Date="18 septembre 2026"
                            Title="Livres de droit ↔ Atlas de géographie"
                            Partner="Avec Nina Moreau" />
                        <controls:ExchangeResultCard Date="10 septembre 2026"
                            Title="Grille-pain ↔ Cafetière"
                            Partner="Avec Adam Petit" />
                        <controls:ExchangeResultCard IsSuccess="False"
                            Date="5 septembre 2026"
                            Title="Sac à dos ↔ Enceinte portable"
                            Partner="Avec Emma Roux"
                            Note="Rencontre sans échange d’objets." />
                        <controls:ExchangeResultCard Date="2 septembre 2026"
                            Title="Romans ↔ Support d’ordinateur"
                            Partner="Avec Hugo Laurent" />
                    </VerticalStackLayout>
                    <Label Text="Voir les rendez-vous à venir" Style="{StaticResource TcLinkLarge}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAppointmentsTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="Historique des points et transactions"
                           Style="{StaticResource TcLinkLarge}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPointsTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <controls:BottomTabBar Grid.Row="1" ActiveTab="exchanges" />
    </Grid>
</ContentPage>
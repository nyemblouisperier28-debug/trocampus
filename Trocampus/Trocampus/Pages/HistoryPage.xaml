<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Trocampus.Controls"
             x:Class="Trocampus.Pages.HistoryPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource TcBackground}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout>
                <controls:AppHeader />
                <VerticalStackLayout Padding="28,16,28,28" Spacing="20"
                                     MinimumHeightRequest="644">
                    <!-- Retour -->
                    <Label Text="‹  Mes échanges" Style="{StaticResource TcLinkLarge}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <!-- Introduction -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Historique des échanges" Style="{StaticResource TcTitle}" />
                        <Label Text="Les rencontres terminées et leurs résultats."
                               Style="{StaticResource TcSubtitle}" LineHeight="1.45" />
                    </VerticalStackLayout>
                    <!-- Récapitulatif -->
                    <Border BackgroundColor="{StaticResource TcSurfaceTint}"
                            StrokeThickness="0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label x:Name="HistorySummaryLabel" Text="0 échange terminé" FontFamily="InterRegular"
                                   FontSize="22" LineHeight="1.45"
                                   TextColor="{StaticResource TcText}" />
                            <Label x:Name="HistoryEmptyLabel" Text="Aucun échange enregistré pour le moment." FontFamily="InterRegular"
                                   FontSize="13" LineHeight="1.45"
                                   TextColor="{StaticResource TcMuted}" />
                        </VerticalStackLayout>
                    </Border>
                    <!-- Filtres et période -->
                    <controls:FilterChips Items="Tous,Réussis,Échoués" SelectedIndex="0" />
                    <!-- Échanges terminés -->
                    <VerticalStackLayout x:Name="HistoryItems" Spacing="12" />
                    <Label Text="Voir les rendez-vous à venir" Style="{StaticResource TcLinkLarge}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAppointmentsTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="Historique des points et transactions"
                           Style="{StaticResource TcLinkLarge}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPointsTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <controls:BottomTabBar Grid.Row="1" ActiveTab="exchanges" />
    </Grid>
</ContentPage>
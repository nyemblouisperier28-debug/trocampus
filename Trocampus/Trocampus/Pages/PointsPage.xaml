<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Trocampus.Controls"
             x:Class="Trocampus.Pages.PointsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource TcBackground}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout>
                <controls:AppHeader />
                <VerticalStackLayout Padding="28,16,28,28" Spacing="20"
                                     MinimumHeightRequest="644">
                    <!-- Retour -->
                    <Label Text="‹  Profil" Style="{StaticResource TcLinkLarge}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <!-- Introduction -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Mes points" Style="{StaticResource TcTitle}" />
                        <Label Text="Votre solde et le détail des mouvements."
                               Style="{StaticResource TcSubtitle}" LineHeight="1.45" />
                    </VerticalStackLayout>
                    <!-- Solde -->
                    <Border BackgroundColor="{StaticResource TcSurfaceTint}"
                            StrokeThickness="0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Solde disponible" FontFamily="InterRegular"
                                   FontSize="13" LineHeight="1.45"
                                   TextColor="{StaticResource TcMuted}" />
                            <Label x:Name="BalanceLabel" Text="0 point" FontFamily="InterRegular" FontSize="32"
                                   LineHeight="1.45" TextColor="{StaticResource TcText}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <Label x:Name="EarnedLabel" Text="+0 gagnés" FontFamily="InterRegular"
                                       FontSize="13" LineHeight="1.45"
                                       TextColor="{StaticResource Primary}" />
                                <Label x:Name="SpentLabel" Grid.Column="1" Text="−0 dépensés"
                                       FontFamily="InterRegular" FontSize="13"
                                       LineHeight="1.45" TextColor="{StaticResource TcMuted}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    <!-- Filtres et période -->
                    <controls:FilterChips Items="Tout,Gagnés,Dépensés" SelectedIndex="0" />
                    <controls:SelectField Title="Période" Value="Toutes les dates"
                                          Options="Toutes les dates,Septembre 2026,Octobre 2026" />
                    <Label x:Name="TransactionsSummaryLabel" Text="Aucun mouvement · solde initial : 0 pt"
                           Style="{StaticResource TcMeta12}" />
                    <!-- Transactions -->
                          <VerticalStackLayout x:Name="TransactionsList" Spacing="8" />
                    <!-- Invitations en attente -->
                    <Border Style="{StaticResource TcPanel}">
                        <VerticalStackLayout Spacing="12">
                            <controls:StatusBadge Text="Aucune invitation en attente"
                                                  Kind="Warning" />
                            <Label FontFamily="InterRegular" FontSize="13" LineHeight="1.45"
                                   TextColor="{StaticResource TcMuted}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Les points gagnés et dépensés seront affichés ici après votre première activité." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                        <Button Text="Inviter une personne · +10 points" Style="{StaticResource TcSecondaryButton}"
                            Clicked="OnInviteClicked" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <controls:BottomTabBar Grid.Row="1" ActiveTab="profile" />
    </Grid>
</ContentPage>
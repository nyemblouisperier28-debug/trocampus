<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Trocampus.Controls"
             x:Class="Trocampus.Pages.PointsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource TcBackground}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout>
                <controls:AppHeader />
                <VerticalStackLayout Padding="28,16,28,28" Spacing="20"
                                     MinimumHeightRequest="644">
                    <!-- Retour -->
                    <Label Text="‹  Profil" Style="{StaticResource TcLinkLarge}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <!-- Introduction -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Mes points" Style="{StaticResource TcTitle}" />
                        <Label Text="Votre solde et le détail des mouvements."
                               Style="{StaticResource TcSubtitle}" LineHeight="1.45" />
                    </VerticalStackLayout>
                    <!-- Solde -->
                    <Border BackgroundColor="{StaticResource TcSurfaceTint}"
                            StrokeThickness="0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Solde disponible" FontFamily="InterRegular"
                                   FontSize="13" LineHeight="1.45"
                                   TextColor="{StaticResource TcMuted}" />
                            <Label Text="120 points" FontFamily="InterRegular" FontSize="32"
                                   LineHeight="1.45" TextColor="{StaticResource TcText}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <Label Text="+180 gagnés" FontFamily="InterRegular"
                                       FontSize="13" LineHeight="1.45"
                                       TextColor="{StaticResource Primary}" />
                                <Label Grid.Column="1" Text="−60 dépensés"
                                       FontFamily="InterRegular" FontSize="13"
                                       LineHeight="1.45" TextColor="{StaticResource TcMuted}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    <!-- Filtres et période -->
                    <controls:FilterChips Items="Tout,Gagnés,Dépensés" SelectedIndex="0" />
                    <controls:SelectField Title="Période" Value="Toutes les dates"
                                          Options="Toutes les dates,Septembre 2026,Octobre 2026" />
                    <Label Text="6 mouvements confirmés · solde initial : 0 pt"
                           Style="{StaticResource TcMeta12}" />
                    <!-- Transactions -->
                    <VerticalStackLayout Spacing="12">
                        <controls:TransactionCard Title="Invitation · Inès" Date="6 oct. 2026"
                            Amount="+20 pt" Status="Confirmée" />
                        <controls:TransactionCard Title="Invitation · Paul" Date="3 oct. 2026"
                            Amount="+20 pt" Status="Confirmée" />
                        <controls:TransactionCard Title="Manuel d’économie · Hugo"
                            Date="28 sept. 2026" Amount="−60 pt" Status="Terminée"
                            IsCredit="False" />
                        <controls:TransactionCard Title="Échange · petit bureau"
                            Date="24 sept. 2026" Amount="+40 pt" Status="Confirmée" />
                        <controls:TransactionCard Title="Échange · livres de droit"
                            Date="18 sept. 2026" Amount="+40 pt" Status="Confirmée" />
                        <controls:TransactionCard Title="Échange · grille-pain"
                            Date="10 sept. 2026" Amount="+60 pt" Status="Confirmée" />
                    </VerticalStackLayout>
                    <!-- Invitations en attente -->
                    <Border Style="{StaticResource TcPanel}">
                        <VerticalStackLayout Spacing="12">
                            <controls:StatusBadge Text="Invitations en attente · 2"
                                                  Kind="Warning" />
                            <Label FontFamily="InterRegular" FontSize="13" LineHeight="1.45"
                                   TextColor="{StaticResource TcMuted}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Aucun point crédité pour ces invitations. " />
                                        <Span Text="Elles ne sont pas incluses dans le solde." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                    <Label Text="Voir mes invitations" Style="{StaticResource TcLinkLarge}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <controls:BottomTabBar Grid.Row="1" ActiveTab="profile" />
    </Grid>
</ContentPage>